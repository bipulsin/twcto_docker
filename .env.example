# Copy to .env and fill in production secrets before `docker compose up`.
# Defaults match the seeded PostgreSQL image (change passwords in production).

POSTGRES_DB=trademanthan
POSTGRES_USER=trademanthan
POSTGRES_PASSWORD=trademanthan123

DATABASE_URL=postgresql://trademanthan:trademanthan123@postgres:5432/trademanthan
REDIS_URL=redis://redis:6379

ENVIRONMENT=production
DEBUG=false
DOMAIN=localhost
HTTP_PORT=8080

SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login.html

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8080/scan/upstox/callback

MARKETAUX_API_TOKEN=
OPENAI_API_KEY=

# Optional notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_TRADEWITHCTO_CHAT_ID=
# ALERT_EMAIL=
# SMTP_SERVER=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=

# ChartInk webhooks
# CHARTINK_DF_SECRET=
# CHARTINK_DF_BEARISH_SECRET=

# Image overrides (when using pre-built GHCR images)
# TWCTO_APP_IMAGE=ghcr.io/bipulsin/twcto-app:latest
# TWCTO_NGINX_IMAGE=ghcr.io/bipulsin/twcto-nginx:latest
