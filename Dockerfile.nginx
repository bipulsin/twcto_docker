# Nginx reverse proxy + static frontend for TradeWithCTO

ARG TRADEMANTHAN_REPO=https://github.com/bipulsin/trademanthan.git
ARG TRADEMANTHAN_REF=main

FROM alpine:3.20 AS frontend-src

ARG TRADEMANTHAN_REPO
ARG TRADEMANTHAN_REF

RUN apk add --no-cache git rsync \
    && git clone --depth 1 --branch "${TRADEMANTHAN_REF}" "${TRADEMANTHAN_REPO}" /tmp/src \
    && mkdir -p /frontend \
    && rsync -a /tmp/src/frontend/public/ /frontend/ \
    && rm -rf /tmp/src

FROM nginx:1.27-alpine

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-src /frontend /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
